<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Hermes 系统深色主题 token：保留低饱和深色表面，与 WebUI 深色主体协调 -->
    <!--
        对比度改善（r49b）：提升所有强调色/按钮色的亮度，确保暗色背景上 WCAG AA ≥4.5:1。
        - hermes_accent（对话框按钮文本、二级主题色）: #818CF8→#A5B4FC（~4.6:1 → ~5.5:1 对 surface）
        - hermes_accent_soft（步进器 ±、添加按钮、选中指示器文本）: #A5B4FC→#C7D2FE（更亮、更明显）
        - hermes_connect（连接按钮背景）: 保持 #6366F1 以维持白字 ~4.5:1 AA 对比度
        - hermes_danger / success / warning 等语义色对照度已足够，微调边值更清晰
    -->
    <color name="hermes_primary">#0F1115</color>
    <color name="hermes_primary_dark">#090B10</color>
    <color name="hermes_page_bg_start">#0B0F14</color>
    <color name="hermes_page_bg_center">#111827</color>
    <color name="hermes_page_bg_end">#0F1115</color>
    <color name="hermes_accent">#A5B4FC</color>
    <color name="hermes_accent_soft">#C7D2FE</color>
    <color name="hermes_accent_pressed">#818CF8</color>
    <color name="hermes_accent_tint">#1E1B4B</color>
    <color name="hermes_surface">#151922</color>
    <color name="hermes_surface_elevated">#1F2937</color>
    <color name="hermes_surface_selected">#24213A</color>
    <color name="hermes_border">#475569</color>
    <color name="hermes_text_primary">#F8FAFC</color>
    <color name="hermes_text_secondary">#E2E8F0</color>
    <color name="hermes_text_muted">#94A3B8</color>
    <color name="hermes_on_action">#FFFFFF</color>
    <color name="hermes_success">#4ADE80</color>
    <color name="hermes_warning">#FBBF24</color>
    <color name="hermes_connect">#6366F1</color>
    <color name="hermes_connect_pressed">#4F46E5</color>
    <color name="hermes_disabled_surface">#64748B</color>
    <color name="hermes_danger">#FB7185</color>
    <color name="hermes_danger_pressed">#E11D48</color>
    <!-- Splash 背景色 -->
    <color name="splash_background">#0F1115</color>
</resources>
